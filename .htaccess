# Keep HTML, CSS and JavaScript fresh after Git deployments.
# Browsers revalidate these files so updated versions are picked up without
# the old automatic reload/flicker behaviour.
<IfModule mod_headers.c>
    <FilesMatch "\.(html?|css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Do not let a previously cached failed response hide the Stichting logo.
    <FilesMatch "^stichtingsuperhelden\.png$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# Serve the Stichting Superhelden logo from the canonical repository asset.
# This also fixes deployments where the static PNG was not copied correctly.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^assets/workedwith/stichtingsuperhelden\.png$ https://raw.githubusercontent.com/Bendemen-Studios/JustPetrov/main/assets/workedwith/stichtingsuperhelden.png [R=302,L]
</IfModule>

# Never expose the root environment file.
<FilesMatch "^\.env(?:\.|$)">
    Require all denied
</FilesMatch>

# The Spotify quota log is private and is only exposed through the authenticated admin endpoint.
<FilesMatch "^quota-log\.json$">
    Require all denied
</FilesMatch>
