# Keep HTML, CSS and JavaScript fresh after Git deployments.
# Browsers revalidate these files so updated versions are picked up without
# the old automatic reload/flicker behaviour.
<IfModule mod_headers.c>
    <FilesMatch "\.(html?|css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# The original Stichting Superhelden PNG is not rendering reliably on the live host.
# Serve the local SVG replacement instead, while keeping the existing image URL.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^assets/workedwith/stichtingsuperhelden\.png$ /assets/workedwith/stichtingsuperhelden.svg [L]
</IfModule>

# Never expose the root environment file.
<FilesMatch "^\.env(?:\.|$)">
    Require all denied
</FilesMatch>
